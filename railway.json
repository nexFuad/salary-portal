{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "cd backend && pnpm install --frozen-lockfile && pnpm prisma generate && pnpm build",
    "watchPatterns": ["backend/**", "railway.json"]
  },
  "deploy": {
    "startCommand": "cd backend && node dist/index.js",
    "preDeployCommand": ["cd backend && pnpm prisma migrate deploy"],
    "healthcheckPath": "/health",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
