generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OFFICER
  OM
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
  ACTIVE
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id                    String                 @id @default(cuid())
  name                  String?
  email                 String?                @unique
  phone                 String?
  profilePic            String?
  employeeId            String
  company               String
  passwordHash          String
  role                  UserRole
  dateOfBirth           DateTime?
  gender                String?
  accountStatus         String?                @default("Active")
  department            String?
  designation           String?
  employmentType        String?
  workDaysPerWeek       Int?
  workStartTime         String                 @default("09:00")
  workEndTime           String                 @default("15:00")
  joinDate              DateTime?
  employmentStatus      String?                @default("Active")
  basicSalary           Decimal?               @db.Decimal(12, 2)
  salaryType            String?
  allowances            Decimal?               @db.Decimal(12, 2)
  attendanceBonusThreshold Decimal?            @db.Decimal(5, 2)
  effectiveSalaryDate   DateTime?
  address               String?
  city                  String?
  country               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  manager               String?
  workLocation          String?
  lastLogin             DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  refreshSessions       RefreshSession[]
  leaveRequests         LeaveRequest[]
  attendanceRecords     AttendanceRecord[]
  salaryAdvanceRequests SalaryAdvanceRequest[]
  loanRequests          LoanRequest[]
  documents             UserDocument[]
  payrollRecords        PayrollRecord[]

  @@unique([employeeId, company])
}

model PayrollRecord {
  id               String   @id @default(cuid())
  payRunMonth      DateTime
  periodStart      DateTime
  periodEnd        DateTime
  expectedWorkDays Int
  attendedDays     Int
  basicSalary      Decimal  @db.Decimal(12, 2)
  bonusAmount      Decimal  @default(0) @db.Decimal(12, 2)
  netSalary        Decimal  @db.Decimal(12, 2)
  status           String   @default("Pending approval")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, payRunMonth])
  @@index([payRunMonth])
}

model SalaryAdvanceRequest {
  id              String        @id @default(cuid())
  requestedAmount Decimal       @db.Decimal(12, 2)
  reason          String
  repaymentMonths Int
  note            String?
  requestDate     DateTime      @default(now())
  status          RequestStatus @default(PENDING)
  approvedAmount  Decimal?      @db.Decimal(12, 2)
  adminNote       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}

model LoanRequest {
  id                 String        @id @default(cuid())
  loanType           String
  requestedAmount    Decimal       @db.Decimal(12, 2)
  purpose            String
  repaymentMonths    Int
  installments       Int
  preferredStartDate DateTime
  note               String?
  requestDate        DateTime      @default(now())
  status             RequestStatus @default(PENDING)
  approvedAmount     Decimal?      @db.Decimal(12, 2)
  adminNote          String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}

model UserDocument {
  id           String         @id @default(cuid())
  title        String
  documentType String
  description  String?
  fileUrl      String
  fileName     String
  mimeType     String
  fileSize     Int
  status       DocumentStatus @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AttendanceRecord {
  id               String    @id @default(cuid())
  workDate         DateTime
  checkInAt        DateTime
  checkInPhotoUrl  String
  checkOutAt       DateTime?
  checkOutPhotoUrl String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, workDate])
}

model LeaveRequest {
  id        String             @id @default(cuid())
  leaveType String
  reason    String
  note      String?
  startDate DateTime
  endDate   DateTime
  status    LeaveRequestStatus @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}

model RefreshSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  persistent Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
